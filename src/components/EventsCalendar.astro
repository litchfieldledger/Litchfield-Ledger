---
// Day-grouped event list with category filter chips. Used by every /events page.
import { CATEGORY_META, featuredPicks, SPONSOR_EMAIL, SPONSOR_MAILTO } from '../lib/events';
import type { CalendarDay, CalendarEvent, Category } from '../lib/events';

interface Props {
  days: CalendarDay[];
  showFilters?: boolean;
  emptyText?: string;
  /** Sponsored "Featured" strip above the list (only renders when something is featured). */
  showFeatured?: boolean;
  /** "Want your event featured?" note under the list. */
  showSponsorNote?: boolean;
}

const {
  days,
  showFilters = true,
  emptyText = 'Nothing on the calendar yet.',
  showFeatured = true,
  showSponsorNote = true,
} = Astro.props;
const total = days.reduce((n, d) => n + d.events.length, 0);
const featured = showFeatured ? featuredPicks(days) : [];

const whenLabel = (ev: CalendarEvent) => {
  const day = new Date(`${ev.date}T12:00:00`).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
  return ev.time ? `${day} · ${ev.time}` : day;
};

const counts = {} as Record<Category, number>;
(Object.keys(CATEGORY_META) as Category[]).forEach((c) => (counts[c] = 0));
for (const d of days) for (const e of d.events) counts[e.category] += 1;
const categories = (Object.keys(CATEGORY_META) as Category[]).filter((c) => counts[c] > 0);

const submitUrl = 'https://litchfieldledger.beehiiv.com/add-your-event';

const timeLabel = (time: string, endTime: string) => {
  if (!time) return 'TBA';
  return endTime ? `${time} – ${endTime}` : time;
};
const placeLabel = (venue: string, town: string) => {
  if (venue && town && !venue.toLowerCase().includes(town.toLowerCase())) return `${venue} · ${town}`;
  return venue || town;
};
---

{featured.length > 0 && (
  <div class="feat-wrap" id="featured" aria-label="Featured events">
    <div class="feat-head">
      <span class="feat-kicker">Featured</span>
      <span class="feat-note">Want your event here? <a href={SPONSOR_MAILTO}>Sponsor a featured listing →</a></span>
    </div>
    <div class="feat-grid">
      {featured.map((ev) => (
        <a class="feat-card" data-date={ev.date} href={ev.url || submitUrl} data-track-click="event_click" data-track-location="featured" target={ev.url ? '_blank' : undefined} rel={ev.url ? 'noopener' : undefined}>
          <span class="feat-when">{whenLabel(ev)}</span>
          <span class="feat-name">{ev.name}</span>
          {ev.blurb && <span class="feat-blurb">{ev.blurb}</span>}
          <span class="feat-place">{placeLabel(ev.venue, ev.town)}</span>
        </a>
      ))}
    </div>
  </div>
)}

{showFilters && total > 0 && categories.length > 1 && (
  <div class="cal-filters" role="group" aria-label="Filter events by category">
    <button type="button" class="cal-filter is-active" data-cat="all" aria-pressed="true">All <span class="cal-filter-count">{total}</span></button>
    {categories.map((c) => (
      <button type="button" class="cal-filter" data-cat={c} aria-pressed="false" style={`--cat: ${CATEGORY_META[c].color}`}>
        {CATEGORY_META[c].label} <span class="cal-filter-count">{counts[c]}</span>
      </button>
    ))}
  </div>
)}

<section class="cal-days" id="calendar" aria-live="polite">
  {days.length === 0 && (
    <p class="cal-empty">{emptyText} <a href={submitUrl}>Submit an event</a> and it'll show up here.</p>
  )}
  {days.map((day) => (
    <div class="cal-day" data-date={day.date}>
      <div class="cal-day-head">
        <div class="event-date">
          <span class="event-month">{day.month}</span>
          <span class="event-day">{day.day}</span>
        </div>
        <div class="cal-day-text">
          <span class="cal-day-name">{day.weekday}</span>
          <span class="cal-day-label">{day.label}</span>
        </div>
      </div>
      <ul class="cal-list">
        {day.events.map((ev) => (
          <li class:list={['cal-item', { 'is-featured': ev.featured }]} data-cat={ev.category}>
            <a href={ev.url || submitUrl} data-track-click="event_click" data-track-location={ev.featured ? 'calendar_featured' : 'calendar'} target={ev.url ? '_blank' : undefined} rel={ev.url ? 'noopener' : undefined}>
              <span class="cal-time">{timeLabel(ev.time, ev.endTime)}</span>
              <span class="cal-info">
                <span class="cal-name">{ev.featured && <span class="cal-tag">Featured</span>}{ev.name}</span>
                <span class="cal-place">{placeLabel(ev.venue, ev.town)}</span>
              </span>
              <span class="cal-cat" style={`--cat: ${CATEGORY_META[ev.category].color}`}>{CATEGORY_META[ev.category].label}</span>
              <span class="event-chevron" aria-hidden="true">›</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))}
  <p class="cal-none is-hidden" id="cal-none">No events in this category right now. <a href={submitUrl}>Know of one?</a></p>
  {showSponsorNote && (
    <p class="sponsor-line">
      <span class="sponsor-star" aria-hidden="true">★</span>
      <span>
        <b>Want your event featured?</b> Featured listings appear at the top of this page, highlighted in the calendar, and in the weekly newsletter. They're sponsored placements.
        Email <a href={SPONSOR_MAILTO}>{SPONSOR_EMAIL}</a> with your event and we'll send you the details.
      </span>
    </p>
  )}
</section>

<script is:inline>
(function () {
  const buttons = Array.from(document.querySelectorAll('.cal-filter'));
  const none = document.getElementById('cal-none');

  // The page is built at most once a day, but "today" moves on. Re-derive it in
  // the reader's browser (Connecticut time), drop day blocks that have already
  // passed, and refresh the Today / Tomorrow labels so a build from earlier in
  // the week never shows last Thursday as "Tomorrow".
  let today = '';
  try {
    today = new Date().toLocaleDateString('en-CA', { timeZone: 'America/New_York' });
  } catch (e) {}
  if (/^\d{4}-\d{2}-\d{2}$/.test(today)) {
    const next = new Date(today + 'T12:00:00Z');
    next.setUTCDate(next.getUTCDate() + 1);
    const tomorrow = next.toISOString().slice(0, 10);
    document.querySelectorAll('.feat-card').forEach((card) => {
      if ((card.getAttribute('data-date') || '') < today) card.remove();
    });
    const feat = document.getElementById('featured');
    if (feat && !feat.querySelector('.feat-card')) feat.remove();
    document.querySelectorAll('.cal-day').forEach((block) => {
      const date = block.getAttribute('data-date') || '';
      if (date < today) { block.remove(); return; }
      const name = block.querySelector('.cal-day-name');
      if (!name) return;
      const stale = name.textContent === 'Today' || name.textContent === 'Tomorrow';
      if (date === today) name.textContent = 'Today';
      else if (date === tomorrow) name.textContent = 'Tomorrow';
      else if (stale) name.textContent = new Date(date + 'T12:00:00').toLocaleDateString('en-US', { weekday: 'long' });
    });
  }

  const items = Array.from(document.querySelectorAll('.cal-item'));
  const dayBlocks = Array.from(document.querySelectorAll('.cal-day'));

  // Keep the chip counts honest after past days are dropped.
  buttons.forEach((b) => {
    const cat = b.dataset.cat;
    const n = cat === 'all' ? items.length : items.filter((i) => i.dataset.cat === cat).length;
    const count = b.querySelector('.cal-filter-count');
    if (count) count.textContent = String(n);
    if (cat !== 'all' && n === 0) b.classList.add('is-hidden');
  });
  if (!dayBlocks.length && none) none.classList.remove('is-hidden');
  if (!buttons.length) return;

  function apply(cat) {
    let visible = 0;
    items.forEach((item) => {
      const show = cat === 'all' || item.dataset.cat === cat;
      item.classList.toggle('is-hidden', !show);
      if (show) visible += 1;
    });
    dayBlocks.forEach((block) => {
      const any = block.querySelector('.cal-item:not(.is-hidden)');
      block.classList.toggle('is-hidden', !any);
    });
    if (none) none.classList.toggle('is-hidden', visible > 0);
    buttons.forEach((b) => {
      const active = b.dataset.cat === cat;
      b.classList.toggle('is-active', active);
      b.setAttribute('aria-pressed', active ? 'true' : 'false');
    });
    if (window.gtag) window.gtag('event', 'calendar_filter', { category: cat });
  }

  buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.cat)));

  const fromHash = (window.location.hash || '').replace('#', '');
  if (fromHash && buttons.some((b) => b.dataset.cat === fromHash)) apply(fromHash);
})();
</script>
