---
interface Props {
  showInstagram?: boolean;
}

const { showInstagram = false } = Astro.props;
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <a href="/" class="wordmark" aria-label="The Litchfield Ledger — home">
        <span>THE</span><span class="wordmark-box">LITCHFIELD</span><span>LEDGER</span>
      </a>
      <p>A free Tuesday newsletter full of weekly events + stories about nature, history, and people.</p>
    </div>
    <div class="footer-support">
      <p>The Ledger is free and independent. If you find value in it, consider supporting it.</p>
      <a class="btn-outline" href="https://litchfieldledger.beehiiv.com/upgrade" data-track-click="support_click" data-track-location="footer">Support the Ledger</a>
    </div>
  </div>
  <div class="container footer-bottom">
    <span class="footer-copy">© 2026 The Litchfield Ledger</span>
    <div class="footer-links">
      <a href="/events/" data-track-click="events_click" data-track-location="footer">Calendar</a>
      <a href="/journal/" data-track-click="journal_click" data-track-location="footer">Journal</a>
      <a href="/visit/" data-track-click="visit_click" data-track-location="footer">Visitor guide</a>
      <a href="https://litchfieldledger.beehiiv.com/add-your-event" data-track-click="submit_event_click" data-track-location="footer">Submit an event</a>
      <a href="mailto:patrick@litchfieldledger.com" data-track-click="contact_click" data-track-location="footer">Contact</a>
      {showInstagram && (
        <a class="footer-social" href="https://www.instagram.com/litchfieldledger/" target="_blank" rel="noopener noreferrer" aria-label="Instagram" data-track-click="social_click" data-track-location="footer">
          <img src="/images/instagram-logo.png" alt="" width="1676" height="1675" loading="lazy" decoding="async" />
        </a>
      )}
    </div>
  </div>
</footer>
