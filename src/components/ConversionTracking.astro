<script is:inline>
  (function () {
    const viewedSignupLocations = new Set();
    const signupClickTimes = new Map();
    let activeSignupLocation = '';

    function eventParams(extra) {
      return Object.assign({
        page_path: window.location.pathname,
        page_title: document.title,
      }, extra || {});
    }

    function track(name, params) {
      if (typeof window.gtag !== 'function') return;
      window.gtag('event', name, eventParams(params));
    }

    function trackSignupView(entry) {
      const location = entry.target.dataset.trackSignupView || entry.target.dataset.trackSignup;
      if (!location || viewedSignupLocations.has(location)) return;

      viewedSignupLocations.add(location);
      track('newsletter_form_view', {
        signup_location: location,
      });
    }

    function setupSignupViews() {
      const signupBlocks = document.querySelectorAll('[data-track-signup-view], [data-track-signup]');
      if (!signupBlocks.length) return;

      if (!('IntersectionObserver' in window)) {
        signupBlocks.forEach((block) => trackSignupView({ target: block }));
        return;
      }

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          trackSignupView(entry);
          observer.unobserve(entry.target);
        });
      }, { threshold: 0.5 });

      signupBlocks.forEach((block) => observer.observe(block));
    }

    function setupSignupClicks() {
      function trackSignupClick(location) {
        const now = Date.now();
        const lastTrackedAt = signupClickTimes.get(location) || 0;

        if (!location || now - lastTrackedAt < 1000) return;

        signupClickTimes.set(location, now);
        track('newsletter_form_click', {
          signup_location: location,
        });
      }

      document.addEventListener('pointerdown', (event) => {
        const signupBlock = event.target?.closest?.('[data-track-signup]');
        if (!signupBlock) return;

        trackSignupClick(signupBlock.dataset.trackSignup);
      }, { capture: true, passive: true });

      document.addEventListener('pointerover', (event) => {
        if (event.target?.tagName?.toLowerCase() !== 'iframe') return;

        const signupBlock = event.target.closest('[data-track-signup]');
        activeSignupLocation = signupBlock?.dataset.trackSignup || '';
      }, { capture: true, passive: true });

      window.addEventListener('blur', () => {
        if (document.activeElement?.tagName?.toLowerCase() !== 'iframe') return;
        trackSignupClick(activeSignupLocation);
      });
    }

    // "/event/<slug>/" → "<slug>": which event a click or view is about, for
    // per-event reports (the featured-listing report for sponsors).
    function eventSlugFrom(url) {
      try {
        const m = new URL(url, window.location.href).pathname.match(/^\/event\/([^/]+)/);
        return m ? m[1] : '';
      } catch (e) {
        return '';
      }
    }

    function setupLinkClicks() {
      document.addEventListener('click', (event) => {
        const link = event.target?.closest?.('a[data-track-click]');
        if (!link) return;

        // A link to an event page names that event; an action on an event page
        // (tickets, directions, add to calendar) names the page's event.
        const slug = eventSlugFrom(link.href) || eventSlugFrom(window.location.href);
        track(link.dataset.trackClick, Object.assign({
          link_location: link.dataset.trackLocation || '',
          link_text: link.textContent.trim().replace(/\s+/g, ' ').slice(0, 120),
          link_url: link.href,
        }, slug ? { event_slug: slug } : {}));
      });
    }

    // Sponsored placements: one featured_impression per event and placement
    // per page view, when at least half the listing is on screen.
    function setupFeaturedViews() {
      const blocks = document.querySelectorAll('[data-featured-view]');
      if (!blocks.length || !('IntersectionObserver' in window)) return;
      const seen = new Set();
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          observer.unobserve(entry.target);
          const slug = eventSlugFrom(entry.target.getAttribute('href') || '');
          const placement = entry.target.dataset.featuredView;
          const key = slug + '|' + placement;
          if (!slug || seen.has(key)) return;
          seen.add(key);
          track('featured_impression', { event_slug: slug, placement: placement });
        });
      }, { threshold: 0.5 });
      blocks.forEach((block) => observer.observe(block));
    }

    function init() {
      setupSignupViews();
      setupSignupClicks();
      setupLinkClicks();
      setupFeaturedViews();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init, { once: true });
    } else {
      init();
    }
  })();
</script>
