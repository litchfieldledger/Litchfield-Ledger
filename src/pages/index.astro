---
import SiteFooter from '../components/SiteFooter.astro';
import LatestIssuePreview from '../components/LatestIssuePreview.astro';
import PageHead from '../components/PageHead.astro';
import { getLedgerPosts, getLedgerStats, getLatestIssue } from '../lib/beehiiv';
import { getUpcomingEvents } from '../lib/events';
import '../styles/home.css';

const posts = await getLedgerPosts();
const latestIssue = await getLatestIssue();
const stats = await getLedgerStats();
const events = await getUpcomingEvents({ limit: 3, days: 7 });

const numberFmt = new Intl.NumberFormat('en-US');
const submitUrl = 'https://litchfieldledger.beehiiv.com/add-your-event';

// Seasonal guide card under This Week. Foliage runs Sept 1 through Nov 8
// (evaluated at build time, Connecticut date), so it comes back every year.
const nyToday = new Date().toLocaleDateString('en-CA', { timeZone: 'America/New_York' });
const [, mm, dd] = nyToday.split('-').map(Number);
const showFoliage = mm === 9 || mm === 10 || (mm === 11 && dd <= 8);
const foliageYear = nyToday.slice(0, 4);

const SITE = 'https://litchfieldledger.com';
const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsMediaOrganization',
  name: 'The Litchfield Ledger',
  url: SITE,
  logo: `${SITE}/images/orange-logo.png`,
  description:
    'A free Tuesday newsletter about the nature, history, people, and events of Litchfield County, Connecticut.',
  areaServed: { '@type': 'AdministrativeArea', name: 'Litchfield County, Connecticut' },
  sameAs: ['https://www.instagram.com/litchfieldledger/', 'https://litchfieldledger.beehiiv.com/'],
  contactPoint: { '@type': 'ContactPoint', email: 'patrick@litchfieldledger.com', contactType: 'editorial' },
};
const siteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'The Litchfield Ledger',
  url: SITE,
  publisher: { '@type': 'NewsMediaOrganization', name: 'The Litchfield Ledger' },
};
---

<!DOCTYPE html>
<html lang="en">
<head>
<PageHead
  title="The Litchfield Ledger — Things to Do & Stories from Litchfield County, CT"
  description="A free Tuesday newsletter with this week's things to do in Litchfield County, Connecticut, plus stories about the nature, history, and people of the Northwest Corner."
  path="/"
  jsonLd={[orgJsonLd, siteJsonLd]}
/>
</head>
<body>

<main class="container">

  <section class="hero" data-track-signup-view="hero">
    <div class="hero-bg" aria-hidden="true">
      <picture>
        <source media="(max-width: 768px)" srcset="/images/refresh/hero-mobile-900.jpg">
        <source media="(max-width: 1100px)" srcset="/images/refresh/hero-river-1000.jpg">
        <img src="/images/refresh/hero-river-1600.jpg" alt="" width="1600" height="2133" decoding="async" fetchpriority="high">
      </picture>
    </div>
    <a class="hero-corner" href={submitUrl} data-track-click="submit_event_click" data-track-location="hero">Submit event <span aria-hidden="true">→</span></a>
    <h1 class="hero-title">
      <span>Litchfield</span>
      <span class="hero-title-row">Ledger <img class="hero-book" src="/images/refresh/book.svg" alt="" width="69" height="48"></span>
    </h1>
    <p class="hero-sub">
      <span class="t-desktop">Nature, people, and happenings of our region.</span>
      <span class="t-mobile">A free Tuesday newsletter full of weekly events + stories about nature, history, and people.</span>
    </p>
    <div class="beehiiv-wrap hero-signup" data-track-signup="hero">
      <script is:inline src="https://subscribe-forms.beehiiv.com/v3/loader.js" data-beehiiv-form="48c597c3-c9e3-4c7a-b09b-db8627e0a48e"></script>
    </div>
    {stats && stats.activeSubscribers > 0 && (
      <p class="hero-stats">
        <strong>{numberFmt.format(stats.activeSubscribers)}</strong> locals reading
        {stats.joinedThisWeek > 0 && (
          <span><span class="sep">•</span><span class="new">+{numberFmt.format(stats.joinedThisWeek)}</span> joined this week</span>
        )}
      </p>
    )}
  </section>

  <section class="section" id="this-week">
    <div class="section-head">
      <h2 class="section-title">
        <img class="section-icon icon-calendar" src="/images/refresh/calendar.svg" alt="" width="41" height="42">
        <span class="t-desktop">This Week</span><span class="t-mobile">Calendar</span>
      </h2>
      <a class="section-link" href="/events" data-track-click="events_click" data-track-location="this_week">View all events <span aria-hidden="true">→</span></a>
    </div>
    <ul class="events-row">
      {events.length === 0 && (
        <li class="events-empty">No events on the calendar yet. <a href={submitUrl}>Submit one</a>.</li>
      )}
      {events.map((ev) => (
        <li class="event-cell">
          <a href={ev.url || '/events'} data-track-click="event_click" data-track-location="this_week">
            <div class="event-date">
              <span class="event-month">{ev.month}</span>
              <span class="event-day">{ev.day}</span>
            </div>
            <div class="event-info">
              <span class="event-name">{ev.name}</span>
              <span class="event-sub">
                {ev.time}{ev.time && ev.place && <span class="dot">•</span>}{ev.place}
              </span>
            </div>
            <span class="event-chevron" aria-hidden="true">›</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {showFoliage && (
    <section class="season-card-wrap" aria-label="Seasonal guide">
      <a class="season-card" href="/guides/fall-foliage/" data-track-click="foliage_click" data-track-location="home_season_card">
        <div class="season-card-img">
          <img src="/images/fall-foliage-path-900.jpg" alt="" width="900" height="600" loading="lazy" decoding="async">
        </div>
        <div class="season-card-text">
          <p class="season-card-eyebrow">Fall {foliageYear} · The guide</p>
          <h2 class="season-card-title">Fall Foliage in Litchfield County</h2>
          <p class="season-card-desc">When the leaves peak town by town, the drives worth taking, the overlooks worth the climb, and where to pick apples after.</p>
          <span class="season-card-link">Read the foliage guide <span aria-hidden="true">→</span></span>
        </div>
      </a>
    </section>
  )}

  <section class="section" id="journal">
    <div class="section-head journal-head">
      <h2 class="section-title">
        <img class="section-icon icon-pencil" src="/images/refresh/pencil.svg" alt="" width="19" height="34">
        <span class="t-desktop">Weekly Journals</span><span class="t-mobile">Weekly Journal</span>
      </h2>
      <a class="section-link" href="/journal/" data-track-click="journal_click" data-track-location="journal_head">All issues <span aria-hidden="true">→</span></a>
    </div>
    <ul class="journal-grid" data-beehiiv-feed>
      {posts.length === 0 && (
        <li class="journal-card post-empty">
          <div class="journal-text"><p class="journal-meta">New posts will appear here on the next build.</p></div>
        </li>
      )}
      {posts.map((post, i) => (
        <li class="journal-card">
          <a href={post.url} data-track-click="outbound_post_click" data-track-location="post_list">
            <div class={`journal-thumb tone-${(i % 4) + 1}`}>
              {post.thumbnail && <img src={post.thumbnail} alt="" width="548" height="344" loading="lazy" decoding="async">}
            </div>
            <div class="journal-text">
              <h3 class="journal-title">{post.title}</h3>
              <p class="journal-meta">{post.dateShort}<span class="dot">•</span>{post.readMinutes} min read</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <script is:inline src="/beehiiv-feed.js"></script>

  <LatestIssuePreview issue={latestIssue} />

</main>

<SiteFooter showInstagram={true} />

</body>
</html>
