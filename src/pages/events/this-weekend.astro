---
import PageHead from '../../components/PageHead.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import EventsCalendar from '../../components/EventsCalendar.astro';
import EventsBrowse from '../../components/EventsBrowse.astro';
import { getCalendarDays, townIndex, filterDays, weekendRange, eventsJsonLd, CATEGORY_META } from '../../lib/events';
import type { Category } from '../../lib/events';
import { SUBMIT_URL, SITE, breadcrumbs } from './_shared';
import '../../styles/home.css';
import '../../styles/events.css';

const allDays = await getCalendarDays();
const towns = townIndex(allDays);
const categories = (Object.keys(CATEGORY_META) as Category[]).filter((c) =>
  allDays.some((d) => d.events.some((e) => e.category === c))
);

const weekend = weekendRange();
const days = filterDays(allDays, (e) => e.date >= weekend.start && e.date <= weekend.end);
const total = days.reduce((n, d) => n + d.events.length, 0);

const title = 'Things to Do This Weekend in Litchfield County, CT | The Litchfield Ledger';
const description = `${total} things to do this weekend (${weekend.label}) in Litchfield County, Connecticut: live music, farmers markets, art, hikes, and festivals across Northwest CT.`;
---

<!DOCTYPE html>
<html lang="en">
<head>
<PageHead
  title={title}
  description={description}
  path="/events/this-weekend"
  jsonLd={[
    breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Things to Do', path: '/events' }, { name: 'This Weekend', path: '/events/this-weekend' }]),
    eventsJsonLd(days, `${SITE}/events/this-weekend/`),
  ]}
/>
</head>
<body>

<header class="page-bar container">
  <a href="/" class="wordmark" aria-label="The Litchfield Ledger — home">
    <span>THE</span><span class="wordmark-box">LITCHFIELD</span><span>LEDGER</span>
  </a>
  <a class="page-bar-link" href={SUBMIT_URL} data-track-click="submit_event_click" data-track-location="calendar_bar">Submit event <span aria-hidden="true">→</span></a>
</header>

<main class="container">
  <section class="cal-head">
    <p class="cal-eyebrow"><a href="/events">Things to Do</a> · {weekend.label}</p>
    <h1 class="cal-title">
      <img class="cal-title-icon" src="/images/refresh/calendar.svg" alt="" width="41" height="42">
      This Weekend in Litchfield County
    </h1>
    <p class="cal-sub">
      Friday through Sunday across Northwest Connecticut. Concerts on the green, Saturday farmers markets,
      gallery openings, guided hikes, and whatever the towns have cooked up. Updated every week from the
      Ledger's event tracker.
    </p>
    <EventsBrowse towns={towns} categories={categories} current="/events/this-weekend" />
  </section>

  <EventsCalendar days={days} emptyText={`Nothing posted yet for ${weekend.label}.`} />
</main>

<SiteFooter showInstagram={true} />

</body>
</html>
